# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin panel password (choose a strong one)
ADMIN_PASSWORD=

# Vercel Cron protection (Settings → Environment Variables; Vercel sends it automatically)
CRON_SECRET=

# Resend (optional, for adding subscribers to an audience)
RESEND_API_KEY=
RESEND_AUDIENCE_ID=

# Public site URL for SEO
NEXT_PUBLIC_SITE_URL=https://nocturnacompass.com

# ===== v2: collectors =====
# EDMTrain — official API. ⚠️ ToS forbids combining with other sources in a
# competing discovery service — get written OK from api@edmtrain.com first.
EDMTRAIN_ENABLED=false
EDMTRAIN_API_KEY=

# Resident Advisor — unofficial GraphQL, disabled by default (ToS risk).
RA_ENABLED=false
RA_AREA_ID=23

# Facebook Graph API — long-lived token; reads events of pages you manage/authorized.
FB_ACCESS_TOKEN=

# Apify (optional) — for FB pages you don't manage; use consciously.
APIFY_TOKEN=
APIFY_FB_ACTOR=

# Newsletter sender identity (verified domain in Resend)
NEWSLETTER_FROM="Nocturna Compass <guide@nocturnacompass.com>"
